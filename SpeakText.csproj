<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SpeakText.App</RootNamespace>
    <AssemblyName>SpeakText</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Title>SpeakText</Title>
    <Product>SpeakText</Product>
    <Company>SpeakText</Company>
    <Description>Windows overlay that reads the current text selection aloud with local Windows voices.</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**\*;dist\**\*;tmp-remote-check\**\*;tmp-remote-check-*\**\*;src\SpeakText.App\bin\**\*;src\SpeakText.App\obj\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
