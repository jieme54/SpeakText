<Window x:Class="SpeakText.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeakText"
        Width="404"
        MinWidth="404"
        MaxWidth="404"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FFFFFFFF"
        Topmost="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF1E66F5"/>
        <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#FFEAF2FF"/>
        <SolidColorBrush x:Key="AccentBlueBorderBrush" Color="#FFC9DAFF"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF16304F"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5E7694"/>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource AccentBlueBorderBrush}"
            BorderThickness="1"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFF7FAFF"
                    BorderBrush="{StaticResource AccentBlueBorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="8,4,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Text="SpeakText"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button x:Name="SettingsButton"
                                Style="{StaticResource ChromeButtonStyle}"
                                Click="SettingsButton_Click"
                                ToolTip="Settings"
                                Content="&#x2699;"/>
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource ChromeButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize"
                                Content="_"/>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource ChromeButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTip="Close"
                                Content="X"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="118"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="LanguageComboBox"
                          Grid.Row="0"
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          MinHeight="32"
                          Padding="8,5"
                          Background="White"
                          BorderBrush="{StaticResource AccentBlueBorderBrush}"
                          SelectionChanged="LanguageComboBox_SelectionChanged"/>

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ModelBadgeTextBlock"
                               Foreground="{StaticResource AccentBlueBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="Windows Voices"/>
                    <TextBlock x:Name="ShortcutHintTextBlock"
                               Margin="0,2,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Text="Shortcut: Ctrl + Alt + Shift + F12"/>
                </StackPanel>

                <Button x:Name="PlayPauseButton"
                        Grid.Row="0"
                        Grid.Column="2"
                        MinHeight="32"
                        Padding="10,8"
                        Click="PlayPauseButton_Click"
                        Background="{StaticResource AccentBlueBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Content="Read Selection"/>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontSize="11"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>
            </Grid>
        </Grid>
    </Border>
</Window>
